            "grip_secure_pressure_bar": {
              "type": "number"
            },
            "grip_secure_time_ms": {
              "type": "integer",
              "minimum": 0
            },
            "grip_timeout_ms": {
              "type": "integer",
              "minimum": 0
            },
            "tailgate_inhibit": {
              "type": "boolean"
            },
            "batt_temp_max_c": {
